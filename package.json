{
  "name": "tldraw-2",
  "version": "0.0.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsup && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/spike-b.mjs && npm run test:spike-c && node scripts/spike-d.mjs && node scripts/spike-e.mjs && node scripts/spike-f.mjs && node scripts/spike-g.mjs && node scripts/spike-h.mjs",
    "test:spike-c": "sh -c 'rm -rf /tmp/opencode/spikec-data && PORT=3051 DATA_DIR=/tmp/opencode/spikec-data node dist/server/index.js & SRV=$!; trap \"kill $SRV; rm -rf /tmp/opencode/spikec-data\" EXIT; for i in $(seq 1 120); do curl -sf http://127.0.0.1:3051/api/health >/dev/null && break; sleep 0.25; done; node scripts/spike-c.mjs'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.94",
    "@ai-sdk/google": "^2.0.87",
    "@ai-sdk/openai": "^2.0.117",
    "@tldraw/commenting": "^5.3.2",
    "@tldraw/sync": "^5.3.2",
    "@tldraw/sync-core": "^5.3.2",
    "@tldraw/tlschema": "^5.3.2",
    "@tldraw/validate": "^5.3.2",
    "ai": "^5.0.238",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "multer": "^2.2.0",
    "music-metadata": "^11.15.0",
    "nanoid": "^5.1.16",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "^10.1.0",
    "tldraw": "^5.3.2",
    "ws": "^8.21.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
