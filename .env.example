# AI — OpenAI-compatible provider (required for the room AI).
# OPENAI_DEFAULT_MODEL must be an id from AGENT_MODEL_DEFINITIONS
# (src/shared/agent/models.ts) or the run falls back to the kit default.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-5.4-mini

# AI — optional extra providers (picked up by the model picker when set)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Host tokens / signing (set a real random value in production)
SESSION_SECRET=dev-secret-change-me

# Server
PORT=3000
DATA_DIR=/data
# Music folder (defaults to DATA_DIR/music)
MUSIC_DIR=