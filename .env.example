# AI — providers are tried Google-first, then custom OpenAI-compatible, then Anthropic.
# Easiest setup: set only GOOGLE_API_KEY and the server defaults to gemini-3.5-flash.
# A failed run retries once on the cheap fallback (flash-lite / gpt-5.4-mini / haiku)
# before surfacing a readable error.
#
# OPENAI_DEFAULT_MODEL must be an id from AGENT_MODEL_DEFINITIONS
# (src/shared/agent/models.ts). Used only when GOOGLE_API_KEY is unset;
# otherwise Gemini Flash is the default. An invalid id is ignored.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-5.4-mini

# AI — Google-first default (recommended: set this alone for the easiest setup)
GOOGLE_API_KEY=

# AI — optional third provider (used last)
ANTHROPIC_API_KEY=

# Host tokens / signing (set a real random value in production)
SESSION_SECRET=dev-secret-change-me

# Server
PORT=3000
DATA_DIR=/data
# Music folder (defaults to DATA_DIR/music)
MUSIC_DIR=